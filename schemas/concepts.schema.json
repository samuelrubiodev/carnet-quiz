{
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 180,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "maxLength": 100,
      "minLength": 2,
      "title": "Topic",
      "type": "string"
    },
    "subtopic": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtopic"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "importance": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Importance",
      "type": "string"
    },
    "difficulty": {
      "maximum": 5,
      "minimum": 1,
      "title": "Difficulty",
      "type": "integer"
    },
    "exam_relevant": {
      "default": true,
      "title": "Exam Relevant",
      "type": "boolean"
    },
    "source_segment_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Source Segment Ids",
      "type": "array"
    },
    "source_start": {
      "minimum": 0,
      "title": "Source Start",
      "type": "number"
    },
    "source_end": {
      "exclusiveMinimum": 0,
      "title": "Source End",
      "type": "number"
    }
  },
  "required": [
    "id",
    "title",
    "topic",
    "summary",
    "importance",
    "difficulty",
    "source_segment_ids",
    "source_start",
    "source_end"
  ],
  "title": "ConceptInput",
  "type": "object"
}