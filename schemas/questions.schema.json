{
  "$defs": {
    "OptionInput": {
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,19}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "OptionInput",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,99}$",
      "title": "Id",
      "type": "string"
    },
    "concept_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
      "title": "Concept Id",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "difficulty": {
      "maximum": 5,
      "minimum": 1,
      "title": "Difficulty",
      "type": "integer"
    },
    "question": {
      "maxLength": 700,
      "minLength": 8,
      "title": "Question",
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/OptionInput"
      },
      "maxItems": 4,
      "minItems": 3,
      "title": "Options",
      "type": "array"
    },
    "correct_option": {
      "title": "Correct Option",
      "type": "string"
    },
    "explanation": {
      "maxLength": 1000,
      "minLength": 8,
      "title": "Explanation",
      "type": "string"
    },
    "source_segment_ids": {
      "items": {
        "type": "integer"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Source Segment Ids",
      "type": "array"
    },
    "source_start": {
      "minimum": 0,
      "title": "Source Start",
      "type": "number"
    },
    "source_end": {
      "exclusiveMinimum": 0,
      "title": "Source End",
      "type": "number"
    }
  },
  "required": [
    "id",
    "concept_id",
    "type",
    "difficulty",
    "question",
    "options",
    "correct_option",
    "explanation",
    "source_segment_ids",
    "source_start",
    "source_end"
  ],
  "title": "QuestionInput",
  "type": "object"
